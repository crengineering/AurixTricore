    /end MEASUREMENT

    /begin MEASUREMENT EthBytesPerSec "Ethernet throughput, transmit and receive summed"
      ULONG NO_COMPU_METHOD 0 0 0 125000000
      ECU_ADDRESS 0x70030084
      PHYS_UNIT "B/s"
    /end MEASUREMENT

    /begin MEASUREMENT EthUtilisation "link utilisation against the negotiated line rate"
      UWORD NO_COMPU_METHOD 0 0 0 1000
      ECU_ADDRESS 0x70030088
      PHYS_UNIT "per mille"
    /end MEASUREMENT

    /begin MEASUREMENT EthLinkSpeed "negotiated link rate"
      UWORD NO_COMPU_METHOD 0 0 0 1000
      ECU_ADDRESS 0x7003008A
      PHYS_UNIT "Mbit/s"
    /end MEASUREMENT

    /begin MEASUREMENT MagPresent "1 if the MMC5983MA answered at init, else 0"
      UBYTE NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x7003008C
    /end MEASUREMENT

    /begin MEASUREMENT MagX "MMC5983MA magnetic field X"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -8 8
      ECU_ADDRESS 0x70030090
      PHYS_UNIT "G"
    /end MEASUREMENT

    /begin MEASUREMENT MagY "MMC5983MA magnetic field Y"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -8 8
      ECU_ADDRESS 0x70030094
      PHYS_UNIT "G"
    /end MEASUREMENT

    /begin MEASUREMENT MagZ "MMC5983MA magnetic field Z"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -8 8
      ECU_ADDRESS 0x70030098
      PHYS_UNIT "G"
    /end MEASUREMENT

    /begin MEASUREMENT MagFieldMagnitude "total field |B| - independent of orientation, ~0.48 G in Munich"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 8
      ECU_ADDRESS 0x7003009C
      PHYS_UNIT "G"
    /end MEASUREMENT

    /begin MEASUREMENT MagHeading "heading from X/Y - LEVEL ONLY, uncalibrated, no declination"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 360
      ECU_ADDRESS 0x700300A0
      PHYS_UNIT "deg"
    /end MEASUREMENT

    /begin MEASUREMENT GnssPresent "1 if the NEO-M9N is answering (link alive), else 0"
      UBYTE NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x700300A4
    /end MEASUREMENT

    /begin MEASUREMENT GnssYear "UTC year from UBX-NAV-PVT"
      UWORD NO_COMPU_METHOD 0 0 0 65535
      ECU_ADDRESS 0x700300A6
      PHYS_UNIT "y"
    /end MEASUREMENT

    /begin MEASUREMENT GnssMonth "UTC month, 1..12"
      UBYTE NO_COMPU_METHOD 0 0 0 12
      ECU_ADDRESS 0x700300A8
    /end MEASUREMENT

    /begin MEASUREMENT GnssDay "UTC day of month, 1..31"
      UBYTE NO_COMPU_METHOD 0 0 0 31
      ECU_ADDRESS 0x700300A9
    /end MEASUREMENT

    /begin MEASUREMENT GnssHour "UTC hour, 0..23"
      UBYTE NO_COMPU_METHOD 0 0 0 23
      ECU_ADDRESS 0x700300AA
    /end MEASUREMENT

    /begin MEASUREMENT GnssMinute "UTC minute, 0..59"
      UBYTE NO_COMPU_METHOD 0 0 0 59
      ECU_ADDRESS 0x700300AB
    /end MEASUREMENT

    /begin MEASUREMENT GnssSecond "UTC second, 0..60 (60 during a leap second)"
      UBYTE NO_COMPU_METHOD 0 0 0 60
      ECU_ADDRESS 0x700300AC
    /end MEASUREMENT

    /begin MEASUREMENT GnssFixOk "1 = the receiver says the solution is valid (gnssFixOK set, invalidLlh clear). Necessary but NOT sufficient - use GnssNavOk"
      UBYTE NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x700300AD
    /end MEASUREMENT

    /begin MEASUREMENT GnssTimeOk "1 = UTC date and time are fully resolved. When 0 the date/time fields read 0 - the receiver's own free-running clock is NOT published, it looks like real data"
      UBYTE NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x700300AE
    /end MEASUREMENT

    /begin MEASUREMENT GnssNavOk "THE flag to gate sensor fusion on: fix valid AND 3D AND horizontal accuracy within 10 m. Independent of GnssTimeOk"
      UBYTE NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x700300AF
    /end MEASUREMENT

    /begin MEASUREMENT GnssRxBytes "NEO-M9N bytes received on ASCLIN4 since boot - the primary link-health signal"
      ULONG NO_COMPU_METHOD 0 0 0 4294967295
      ECU_ADDRESS 0x700300B0
      PHYS_UNIT "bytes"
    /end MEASUREMENT

    /begin MEASUREMENT GnssSentences "complete NMEA sentences assembled - ~6/s at the 1 Hz default nav rate"
      ULONG NO_COMPU_METHOD 0 0 0 4294967295
      ECU_ADDRESS 0x700300B4
    /end MEASUREMENT

    /begin MEASUREMENT GnssErrors "ASCLIN framing errors + RX FIFO overflows - must stay 0 on a healthy link"
      UWORD NO_COMPU_METHOD 0 0 0 65535
      ECU_ADDRESS 0x700300B8
    /end MEASUREMENT

    /begin MEASUREMENT GnssFixType "fix quality - PHASE B, currently always 0 (no NMEA parser yet)"
      UBYTE NO_COMPU_METHOD 0 0 0 5
      ECU_ADDRESS 0x700300BA
    /end MEASUREMENT

    /begin MEASUREMENT GnssNumSats "satellites used in the solution - PHASE B, currently always 0"
      UBYTE NO_COMPU_METHOD 0 0 0 32
      ECU_ADDRESS 0x700300BB
    /end MEASUREMENT

    /begin MEASUREMENT GnssLatitude "latitude from UBX-NAV-PVT, WGS84. Stored as float32 so ~0.4 m of the receiver's 1.1 cm resolution is lost - well below its ~1.5 m accuracy"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -90 90
      ECU_ADDRESS 0x700300BC
      PHYS_UNIT "deg"
    /end MEASUREMENT

    /begin MEASUREMENT GnssLongitude "longitude from UBX-NAV-PVT, WGS84"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -180 180
      ECU_ADDRESS 0x700300C0
      PHYS_UNIT "deg"
    /end MEASUREMENT

    /begin MEASUREMENT GnssAltitude "height above mean sea level (NAV-PVT hMSL)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -1000 20000
      ECU_ADDRESS 0x700300C4
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT GnssGroundSpeed "2-D ground speed (NAV-PVT gSpeed)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 500
      ECU_ADDRESS 0x700300C8
      PHYS_UNIT "m/s"
    /end MEASUREMENT

    /begin MEASUREMENT GnssHeading "2-D heading of motion (NAV-PVT headMot); meaningless when stationary"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -180 360
      ECU_ADDRESS 0x700300CC
      PHYS_UNIT "deg"
    /end MEASUREMENT

    /begin MEASUREMENT GnssHAccuracy "horizontal accuracy estimate (NAV-PVT hAcc) - the number that says whether the fix is trustworthy"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 10000
      ECU_ADDRESS 0x700300D0
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT GnssVAccuracy "vertical accuracy estimate (NAV-PVT vAcc). Typically 1.5-2x worse than horizontal - all satellites are above the receiver, so the geometry for the vertical component is poor"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 10000
      ECU_ADDRESS 0x700300D4
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT FusionDt "measured interval between IMU task runs, the dt the filter integrates with. Nominal 0.020 s; measured rather than assumed so scheduler jitter cannot bias the integral"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -1e12 1e12
      ECU_ADDRESS 0x700300D8
      PHYS_UNIT "s"
    /end MEASUREMENT

    /begin MEASUREMENT FusionAccelDown "acceleration along NED down with gravity removed, the filter's input. Zero at rest and level; NEGATIVE while accelerating upward. LEVEL-SCAFFOLD ONLY until an attitude estimate exists"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -1e12 1e12
      ECU_ADDRESS 0x700300DC
      PHYS_UNIT "m/s^2"
    /end MEASUREMENT

    /begin MEASUREMENT FusionVelocityDown "estimated velocity along NED down. POSITIVE IS DOWN: sinking is positive, climbing negative"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -1e12 1e12
      ECU_ADDRESS 0x700300E0
      PHYS_UNIT "m/s"
    /end MEASUREMENT

    /begin MEASUREMENT FusionAltitudeDown "estimated position along NED down, relative to the first valid barometer sample. POSITIVE IS DOWN, so climbing makes this go negative"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -1e12 1e12
      ECU_ADDRESS 0x700300E4
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT FusionInnovation "barometer innovation: measured altitude minus the filter's prediction. Zero-mean noise means the filter is consistent; a constant offset means the model is missing a term (in stage 3 that offset IS the un-modelled accelerometer bias)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -1e12 1e12
      ECU_ADDRESS 0x700300E8
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT FusionVarAltitude "filter variance of a_d [m^2]. Grows on every predict, shrinks on every barometer correction; it should settle rather than run away"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -1e12 1e12
      ECU_ADDRESS 0x700300EC
      PHYS_UNIT "m^2"
    /end MEASUREMENT

    /begin MEASUREMENT FusionBaroRejects "barometer samples rejected by the 5-sigma outlier gate. A rising count is a sensor fault, not a tuning knob"
      ULONG NO_COMPU_METHOD 0 0 0 4294967295
      ECU_ADDRESS 0x700300F0
      PHYS_UNIT "-"
    /end MEASUREMENT

    /begin MEASUREMENT FusionResets "filter re-acquisitions: the barometer was rejected for 0.5 s straight, so the state was reloaded from it. Non-zero means the filter diverged and recovered -- investigate what threw it off"
      ULONG NO_COMPU_METHOD 0 0 0 4294967295
      ECU_ADDRESS 0x700300F4
      PHYS_UNIT "-"
    /end MEASUREMENT

