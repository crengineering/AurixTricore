    /begin MEASUREMENT Quat1 "body-to-NED quaternion component 1 (w,x,y,z order)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -1 1
      ECU_ADDRESS 0x70030518
    /end MEASUREMENT

    /begin MEASUREMENT Quat2 "body-to-NED quaternion component 2 (w,x,y,z order)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -1 1
      ECU_ADDRESS 0x7003051C
    /end MEASUREMENT

    /begin MEASUREMENT Quat3 "body-to-NED quaternion component 3 (w,x,y,z order)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -1 1
      ECU_ADDRESS 0x70030520
    /end MEASUREMENT

