/* ASAP2/A2L description of the AurixTricore XCP slave (firmware v1.3.0).
 *
 * All objects live at fixed addresses (TASKING __at), so this file does not
 * depend on the link run:
 *   Xcp_Data  (measurements)          0x70030000, 180 bytes, Measurements.h
 *   Xcp_Cal   (calibration, RAM only) 0x70030100, 64 bytes, Diagnostics.h
 *   Xcp_Nvm   (persistent, DFLASH)    0x70030200, 12 bytes, Nvm.h
 *   Xcp_Gpio  (GPIO control, RAM only) 0x70030300, 52 bytes, gpio.h
 * Transport: XCP on UDP/IP, port 5555, station 192.168.0.10.
 * DAQ: dynamic, 1 list, event channel 0 = 100 ms task.
 */
ASAP2_VERSION 1 61

/begin PROJECT AurixTricore "TC399 TriBoard bare-metal project"

  /begin MODULE XCP "AurixTricore XCP slave"

    /begin MOD_COMMON ""
      BYTE_ORDER MSB_LAST
      ALIGNMENT_BYTE 1
      ALIGNMENT_WORD 2
      ALIGNMENT_LONG 4
      ALIGNMENT_FLOAT32_IEEE 4
    /end MOD_COMMON

    /begin MOD_PAR "AurixTricore v1.3.0"
    /end MOD_PAR

    /begin IF_DATA XCP
      /begin PROTOCOL_LAYER
        0x0100                  /* protocol layer version 1.0             */
        1000 1000 1000 1000 1000 1000 1000   /* T1..T7 timeouts [ms]      */
        64                      /* MAX_CTO                                */
        64                      /* MAX_DTO                                */
        BYTE_ORDER_MSB_LAST
        ADDRESS_GRANULARITY_BYTE
        OPTIONAL_CMD GET_ID
        OPTIONAL_CMD SET_MTA
        OPTIONAL_CMD UPLOAD
        OPTIONAL_CMD SHORT_UPLOAD
        OPTIONAL_CMD DOWNLOAD
        OPTIONAL_CMD SHORT_DOWNLOAD
        OPTIONAL_CMD GET_DAQ_PROCESSOR_INFO
        OPTIONAL_CMD GET_DAQ_RESOLUTION_INFO
        OPTIONAL_CMD FREE_DAQ
        OPTIONAL_CMD ALLOC_DAQ
        OPTIONAL_CMD ALLOC_ODT
        OPTIONAL_CMD ALLOC_ODT_ENTRY
      /end PROTOCOL_LAYER
      /begin DAQ
        DYNAMIC
        1                       /* MAX_DAQ                                */
        1                       /* MAX_EVENT_CHANNEL                      */
        0                       /* MIN_DAQ                                */
        OPTIMISATION_TYPE_DEFAULT
        ADDRESS_EXTENSION_FREE
        IDENTIFICATION_FIELD_TYPE_ABSOLUTE
        GRANULARITY_ODT_ENTRY_SIZE_DAQ_BYTE
        63                      /* MAX_ODT_ENTRY_SIZE_DAQ                 */
        NO_OVERLOAD_INDICATION
        /begin EVENT "Task100ms" "100ms" 0x0000 DAQ 0xFF 100 6 0x00
        /end EVENT
      /end DAQ
      /begin XCP_ON_UDP_IP
        0x0100                  /* transport layer version 1.0            */
        5555                    /* port                                   */
        ADDRESS "192.168.0.10"
      /end XCP_ON_UDP_IP
    /end IF_DATA

    /begin RECORD_LAYOUT RL_FLOAT32
      FNC_VALUES 1 FLOAT32_IEEE ROW_DIR DIRECT
    /end RECORD_LAYOUT

    /begin RECORD_LAYOUT RL_ULONG
      FNC_VALUES 1 ULONG ROW_DIR DIRECT
    /end RECORD_LAYOUT

    /begin RECORD_LAYOUT RL_UBYTE
      FNC_VALUES 1 UBYTE ROW_DIR DIRECT
    /end RECORD_LAYOUT

    /* ------------------------------------------------------------------ */
    /* Measurements: Xcp_Data @ 0x70030000 (see Measurements.h)           */
    /* ------------------------------------------------------------------ */

    /begin MEASUREMENT SwVersionMajor "software version major"
      UBYTE NO_COMPU_METHOD 0 0 0 255
      ECU_ADDRESS 0x70030004
    /end MEASUREMENT

    /begin MEASUREMENT SwVersionMinor "software version minor"
      UBYTE NO_COMPU_METHOD 0 0 0 255
      ECU_ADDRESS 0x70030005
    /end MEASUREMENT

    /begin MEASUREMENT SwVersionStep "software version step"
      UBYTE NO_COMPU_METHOD 0 0 0 255
      ECU_ADDRESS 0x70030006
    /end MEASUREMENT

    /begin MEASUREMENT TickMs "board uptime"
      ULONG NO_COMPU_METHOD 0 0 0 4294967295
      ECU_ADDRESS 0x70030008
      PHYS_UNIT "ms"
    /end MEASUREMENT

    /begin MEASUREMENT DieTemp_DTS "die temperature, PMS DTS (standby domain)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -50 170
      ECU_ADDRESS 0x7003000C
      PHYS_UNIT "degC"
    /end MEASUREMENT

    /begin MEASUREMENT DieTemp_DTSC "die temperature, SCU DTSC (core domain)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -50 170
      ECU_ADDRESS 0x70030010
      PHYS_UNIT "degC"
    /end MEASUREMENT

    /begin MEASUREMENT VDD "1.25 V core rail (PMS monitor ADC)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 2
      ECU_ADDRESS 0x70030014
      PHYS_UNIT "V"
    /end MEASUREMENT

    /begin MEASUREMENT VDDP3 "3.3 V I/O rail (PMS monitor ADC)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 5
      ECU_ADDRESS 0x70030018
      PHYS_UNIT "V"
    /end MEASUREMENT

    /begin MEASUREMENT VEXT "5 V board supply (PMS monitor ADC)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 6
      ECU_ADDRESS 0x7003001C
      PHYS_UNIT "V"
    /end MEASUREMENT

    /begin MEASUREMENT RawVdd "raw monitor ADC code VDD"
      UBYTE NO_COMPU_METHOD 0 0 0 255
      ECU_ADDRESS 0x70030020
    /end MEASUREMENT

    /begin MEASUREMENT RawVddp3 "raw monitor ADC code VDDP3"
      UBYTE NO_COMPU_METHOD 0 0 0 255
      ECU_ADDRESS 0x70030021
    /end MEASUREMENT

    /begin MEASUREMENT RawVext "raw monitor ADC code VEXT"
      UBYTE NO_COMPU_METHOD 0 0 0 255
      ECU_ADDRESS 0x70030022
    /end MEASUREMENT

    /begin MEASUREMENT DiagStatus "diagnostics bitmask, see DIAGNOSTICS.md"
      ULONG NO_COMPU_METHOD 0 0 0 4294967295
      ECU_ADDRESS 0x70030024
    /end MEASUREMENT

    /begin MEASUREMENT BaroPressure "BMP581 barometric pressure"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 200000
      ECU_ADDRESS 0x70030028
      PHYS_UNIT "Pa"
    /end MEASUREMENT

    /begin MEASUREMENT BaroTemperature "BMP581 temperature"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -40 85
      ECU_ADDRESS 0x7003002C
      PHYS_UNIT "degC"
    /end MEASUREMENT

    /begin MEASUREMENT BaroAltitude "pressure altitude vs standard 1013.25 hPa"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -500 9000
      ECU_ADDRESS 0x70030030
      PHYS_UNIT "m"
    /end MEASUREMENT

    /* IMU block. ICM-42688-P on QSPI0 from firmware v1.16.0, replacing the
       MPU-6050/GY-521 that came off I2C0 with the BMP388 on 2026-07-31.
       Addresses and layout unchanged across both sensors. */

    /begin MEASUREMENT ImuPresent "1 if the ICM-42688-P answered at init, else 0"
      UBYTE NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030034
    /end MEASUREMENT

    /begin MEASUREMENT ImuAccelX "ICM-42688-P acceleration X"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -8 8
      ECU_ADDRESS 0x70030038
      PHYS_UNIT "g"
    /end MEASUREMENT

    /begin MEASUREMENT ImuAccelY "ICM-42688-P acceleration Y"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -8 8
      ECU_ADDRESS 0x7003003C
      PHYS_UNIT "g"
    /end MEASUREMENT

    /begin MEASUREMENT ImuAccelZ "ICM-42688-P acceleration Z"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -8 8
      ECU_ADDRESS 0x70030040
      PHYS_UNIT "g"
    /end MEASUREMENT

    /begin MEASUREMENT ImuGyroX "ICM-42688-P angular rate X, bias corrected (raw = this + AhrsGyroBiasX)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -2000 2000
      ECU_ADDRESS 0x70030044
      PHYS_UNIT "deg/s"
    /end MEASUREMENT

    /begin MEASUREMENT ImuGyroY "ICM-42688-P angular rate Y, bias corrected (raw = this + AhrsGyroBiasY)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -2000 2000
      ECU_ADDRESS 0x70030048
      PHYS_UNIT "deg/s"
    /end MEASUREMENT

    /begin MEASUREMENT ImuGyroZ "ICM-42688-P angular rate Z, bias corrected (raw = this + AhrsGyroBiasZ)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -2000 2000
      ECU_ADDRESS 0x7003004C
      PHYS_UNIT "deg/s"
    /end MEASUREMENT

    /begin MEASUREMENT ImuTemperature "ICM-42688-P die temperature"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -40 85
      ECU_ADDRESS 0x70030050
      PHYS_UNIT "degC"
    /end MEASUREMENT

    /* Attitude estimate (Ahrs.c), firmware >= v1.12.0.
     * Angles and rates use the src/asw/flight_ctrl.h conventions:
     * phi_ist = [roll, pitch, yaw] in rad, om_ist = [p, q, r] in rad/s. */

    /begin MEASUREMENT AhrsState "attitude estimator state: 0 calibrating, 1 running, 2 no sensor"
      UBYTE NO_COMPU_METHOD 0 0 0 2
      ECU_ADDRESS 0x70030054
    /end MEASUREMENT

    /begin MEASUREMENT AhrsAccelTrusted "1 while |a| is near 1 g and the accelerometer is being fused"
      UBYTE NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030055
    /end MEASUREMENT

    /begin MEASUREMENT AhrsRoll "estimated roll (phi), flight_ctrl phi_ist[0]"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -3.15 3.15
      ECU_ADDRESS 0x70030058
      PHYS_UNIT "rad"
    /end MEASUREMENT

    /begin MEASUREMENT AhrsPitch "estimated pitch (theta), flight_ctrl phi_ist[1]"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -1.58 1.58
      ECU_ADDRESS 0x7003005C
      PHYS_UNIT "rad"
    /end MEASUREMENT

    /begin MEASUREMENT AhrsYaw "estimated yaw (psi), flight_ctrl phi_ist[2] - gyro only, drifts"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -100 100
      ECU_ADDRESS 0x70030060
      PHYS_UNIT "rad"
    /end MEASUREMENT

    /begin MEASUREMENT AhrsRateP "body roll rate p, bias corrected, flight_ctrl om_ist[0]"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -35 35
      ECU_ADDRESS 0x70030064
      PHYS_UNIT "rad/s"
    /end MEASUREMENT

    /begin MEASUREMENT AhrsRateQ "body pitch rate q, bias corrected, flight_ctrl om_ist[1]"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -35 35
      ECU_ADDRESS 0x70030068
      PHYS_UNIT "rad/s"
    /end MEASUREMENT

    /begin MEASUREMENT AhrsRateR "body yaw rate r, bias corrected, flight_ctrl om_ist[2]"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -35 35
      ECU_ADDRESS 0x7003006C
      PHYS_UNIT "rad/s"
    /end MEASUREMENT

    /begin MEASUREMENT AhrsGyroBiasX "gyro bias X measured at start-up"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -50 50
      ECU_ADDRESS 0x70030070
      PHYS_UNIT "deg/s"
    /end MEASUREMENT

    /begin MEASUREMENT AhrsGyroBiasY "gyro bias Y measured at start-up"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -50 50
      ECU_ADDRESS 0x70030074
      PHYS_UNIT "deg/s"
    /end MEASUREMENT

    /begin MEASUREMENT AhrsGyroBiasZ "gyro bias Z measured at start-up"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -50 50
      ECU_ADDRESS 0x70030078
      PHYS_UNIT "deg/s"
    /end MEASUREMENT

    /* Per-core execution time (CoreStats.c). CoreAliveN increments once per
     * 100 ms window; a frozen counter means that core has hung. */

    /begin MEASUREMENT Core0ExecTime "CPU0 busy time in the last 100 ms window"
      ULONG NO_COMPU_METHOD 0 0 0 100000
      ECU_ADDRESS 0x7003007C
      PHYS_UNIT "us"
    /end MEASUREMENT

    /begin MEASUREMENT Core1ExecTime "CPU1 busy time in the last 100 ms window"
      ULONG NO_COMPU_METHOD 0 0 0 100000
      ECU_ADDRESS 0x70030080
      PHYS_UNIT "us"
    /end MEASUREMENT

    /begin MEASUREMENT Core2ExecTime "CPU2 busy time in the last 100 ms window"
      ULONG NO_COMPU_METHOD 0 0 0 100000
      ECU_ADDRESS 0x70030084
      PHYS_UNIT "us"
    /end MEASUREMENT

    /begin MEASUREMENT Core3ExecTime "CPU3 busy time in the last 100 ms window"
      ULONG NO_COMPU_METHOD 0 0 0 100000
      ECU_ADDRESS 0x70030088
      PHYS_UNIT "us"
    /end MEASUREMENT

    /begin MEASUREMENT Core4ExecTime "CPU4 busy time in the last 100 ms window"
      ULONG NO_COMPU_METHOD 0 0 0 100000
      ECU_ADDRESS 0x7003008C
      PHYS_UNIT "us"
    /end MEASUREMENT

    /begin MEASUREMENT Core5ExecTime "CPU5 busy time in the last 100 ms window"
      ULONG NO_COMPU_METHOD 0 0 0 100000
      ECU_ADDRESS 0x70030090
      PHYS_UNIT "us"
    /end MEASUREMENT

    /begin MEASUREMENT Core0Load "CPU0 busy fraction of the window"
      UWORD NO_COMPU_METHOD 0 0 0 1000
      ECU_ADDRESS 0x70030094
      PHYS_UNIT "per mille"
    /end MEASUREMENT

    /begin MEASUREMENT Core1Load "CPU1 busy fraction of the window"
      UWORD NO_COMPU_METHOD 0 0 0 1000
      ECU_ADDRESS 0x70030096
      PHYS_UNIT "per mille"
    /end MEASUREMENT

    /begin MEASUREMENT Core2Load "CPU2 busy fraction of the window"
      UWORD NO_COMPU_METHOD 0 0 0 1000
      ECU_ADDRESS 0x70030098
      PHYS_UNIT "per mille"
    /end MEASUREMENT

    /begin MEASUREMENT Core3Load "CPU3 busy fraction of the window"
      UWORD NO_COMPU_METHOD 0 0 0 1000
      ECU_ADDRESS 0x7003009A
      PHYS_UNIT "per mille"
    /end MEASUREMENT

    /begin MEASUREMENT Core4Load "CPU4 busy fraction of the window"
      UWORD NO_COMPU_METHOD 0 0 0 1000
      ECU_ADDRESS 0x7003009C
      PHYS_UNIT "per mille"
    /end MEASUREMENT

    /begin MEASUREMENT Core5Load "CPU5 busy fraction of the window"
      UWORD NO_COMPU_METHOD 0 0 0 1000
      ECU_ADDRESS 0x7003009E
      PHYS_UNIT "per mille"
    /end MEASUREMENT

    /begin MEASUREMENT Core0Alive "CPU0 liveness counter, frozen if the core hung"
      UWORD NO_COMPU_METHOD 0 0 0 65535
      ECU_ADDRESS 0x700300A0
    /end MEASUREMENT

    /begin MEASUREMENT Core1Alive "CPU1 liveness counter, frozen if the core hung"
      UWORD NO_COMPU_METHOD 0 0 0 65535
      ECU_ADDRESS 0x700300A2
    /end MEASUREMENT

    /begin MEASUREMENT Core2Alive "CPU2 liveness counter, frozen if the core hung"
      UWORD NO_COMPU_METHOD 0 0 0 65535
      ECU_ADDRESS 0x700300A4
    /end MEASUREMENT

    /begin MEASUREMENT Core3Alive "CPU3 liveness counter, frozen if the core hung"
      UWORD NO_COMPU_METHOD 0 0 0 65535
      ECU_ADDRESS 0x700300A6
    /end MEASUREMENT

    /begin MEASUREMENT Core4Alive "CPU4 liveness counter, frozen if the core hung"
      UWORD NO_COMPU_METHOD 0 0 0 65535
      ECU_ADDRESS 0x700300A8
    /end MEASUREMENT

    /begin MEASUREMENT Core5Alive "CPU5 liveness counter, frozen if the core hung"
      UWORD NO_COMPU_METHOD 0 0 0 65535
      ECU_ADDRESS 0x700300AA
    /end MEASUREMENT

    /* Ethernet link (EthStats.c), from the GETH MMC hardware counters */

    /begin MEASUREMENT EthBytesPerSec "Ethernet throughput, transmit and receive summed"
      ULONG NO_COMPU_METHOD 0 0 0 125000000
      ECU_ADDRESS 0x700300AC
      PHYS_UNIT "B/s"
    /end MEASUREMENT

    /begin MEASUREMENT EthUtilisation "link utilisation against the negotiated line rate"
      UWORD NO_COMPU_METHOD 0 0 0 1000
      ECU_ADDRESS 0x700300B0
      PHYS_UNIT "per mille"
    /end MEASUREMENT

    /begin MEASUREMENT EthLinkSpeed "negotiated link rate"
      UWORD NO_COMPU_METHOD 0 0 0 1000
      ECU_ADDRESS 0x700300B2
      PHYS_UNIT "Mbit/s"
    /end MEASUREMENT

    /* MMC5983MA magnetometer on I2C0 0x30, firmware >= v1.15.0. Appended at the
       end of Xcp_Data so every address above kept its value. 1 gauss = 100 uT. */

    /begin MEASUREMENT MagPresent "1 if the MMC5983MA answered at init, else 0"
      UBYTE NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x700300B4
    /end MEASUREMENT

    /begin MEASUREMENT MagX "MMC5983MA magnetic field X"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -8 8
      ECU_ADDRESS 0x700300B8
      PHYS_UNIT "G"
    /end MEASUREMENT

    /begin MEASUREMENT MagY "MMC5983MA magnetic field Y"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -8 8
      ECU_ADDRESS 0x700300BC
      PHYS_UNIT "G"
    /end MEASUREMENT

    /begin MEASUREMENT MagZ "MMC5983MA magnetic field Z"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -8 8
      ECU_ADDRESS 0x700300C0
      PHYS_UNIT "G"
    /end MEASUREMENT

    /begin MEASUREMENT MagFieldMagnitude "total field |B| - independent of orientation, ~0.48 G in Munich"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 8
      ECU_ADDRESS 0x700300C4
      PHYS_UNIT "G"
    /end MEASUREMENT

    /begin MEASUREMENT MagHeading "heading from X/Y - LEVEL ONLY, uncalibrated, no declination"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 360
      ECU_ADDRESS 0x700300C8
      PHYS_UNIT "deg"
    /end MEASUREMENT


    /* individual diagnostics bits (BIT_MASK views on DiagStatus) */

    /begin MEASUREMENT Diag_DTS_Undertemp "DTS temperature below dtsMin"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00000001
    /end MEASUREMENT

    /begin MEASUREMENT Diag_DTS_Overtemp "DTS temperature above dtsMax"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00000002
    /end MEASUREMENT

    /begin MEASUREMENT Diag_DTSC_Undertemp "DTSC temperature below dtscMin"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00000004
    /end MEASUREMENT

    /begin MEASUREMENT Diag_DTSC_Overtemp "DTSC temperature above dtscMax"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00000008
    /end MEASUREMENT

    /begin MEASUREMENT Diag_VDD_Undervolt "VDD below vddMin"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00000010
    /end MEASUREMENT

    /begin MEASUREMENT Diag_VDD_Overvolt "VDD above vddMax"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00000020
    /end MEASUREMENT

    /begin MEASUREMENT Diag_VDDP3_Undervolt "VDDP3 below vddp3Min"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00000040
    /end MEASUREMENT

    /begin MEASUREMENT Diag_VDDP3_Overvolt "VDDP3 above vddp3Max"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00000080
    /end MEASUREMENT

    /begin MEASUREMENT Diag_VEXT_Undervolt "VEXT below vextMin"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00000100
    /end MEASUREMENT

    /begin MEASUREMENT Diag_VEXT_Overvolt "VEXT above vextMax"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00000200
    /end MEASUREMENT

    /begin MEASUREMENT Diag_TempImplausible "delta DTS/DTSC above tempDeltaMax"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00000400
    /end MEASUREMENT

    /begin MEASUREMENT Diag_UartDisconnected "no UART heartbeat from PC GUI for > 2 s"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00000800
    /end MEASUREMENT

    /begin MEASUREMENT Diag_NvmFault "NVM corrupt at boot or last save failed"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00001000
    /end MEASUREMENT


    /* peripheral wiring / communication / liveness faults, firmware >= v1.13.0 */

    /begin MEASUREMENT Diag_I2cSclStuck "I2C0 SCL held low: short to GND or a slave stretching the clock"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00002000
    /end MEASUREMENT

    /begin MEASUREMENT Diag_I2cSdaStuck "I2C0 SDA held low: short to GND or a slave jammed mid-byte"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00004000
    /end MEASUREMENT

    /begin MEASUREMENT Diag_BaroNoResponse "BMP581 never answered since boot: wiring, address or dead part"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00008000
    /end MEASUREMENT

    /begin MEASUREMENT Diag_BaroTimeout "BMP581 answered before and is now silent for > 1 s"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00010000
    /end MEASUREMENT

    /begin MEASUREMENT Diag_BaroStuckData "BMP581 bus healthy but the value stopped changing for > 5 s"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00020000
    /end MEASUREMENT

    /begin MEASUREMENT Diag_BaroImplausible "BMP581 outside 300-1200 hPa or -40..85 degC"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00040000
    /end MEASUREMENT

    /begin MEASUREMENT Diag_ImuNoResponse "ICM-42688-P never answered since boot: level shifters, CS, SPI mode or MRST pad"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00080000
    /end MEASUREMENT

    /begin MEASUREMENT Diag_ImuTimeout "ICM-42688-P answered before and is now silent for > 1 s"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00100000
    /end MEASUREMENT

    /begin MEASUREMENT Diag_ImuStuckData "ICM-42688-P bus healthy but the sample block stopped changing for > 5 s"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00200000
    /end MEASUREMENT

    /begin MEASUREMENT Diag_ImuImplausible "ICM-42688-P |a| outside 0.05..17 g or temperature outside -40..85 degC"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00400000
    /end MEASUREMENT

    /begin MEASUREMENT Diag_MagNoResponse "MMC5983MA never answered since boot: wiring, or CS not tied to +3V3"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x00800000
    /end MEASUREMENT

    /begin MEASUREMENT Diag_MagTimeout "MMC5983MA answered before and is now silent for > 1 s"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x01000000
    /end MEASUREMENT

    /begin MEASUREMENT Diag_MagStuckData "MMC5983MA bus healthy but the field stopped changing for > 5 s"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x02000000
    /end MEASUREMENT

    /begin MEASUREMENT Diag_MagImplausible "MMC5983MA |B| outside 0.15..2.0 G - wrong scaling or axis assembly"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x04000000
    /end MEASUREMENT

    /begin MEASUREMENT Diag_CalInvalid "calibration block magic broken, defaults reloaded"
      ULONG NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030024
      BIT_MASK 0x80000000
    /end MEASUREMENT

    /* ------------------------------------------------------------------ */
    /* Characteristics: Xcp_Cal @ 0x70030100 (see Diagnostics.h)          */
    /* ------------------------------------------------------------------ */

    /begin CHARACTERISTIC CAL_dtsMin "lower limit DTS temperature"
      VALUE 0x70030104 RL_FLOAT32 300 NO_COMPU_METHOD -50 170
      PHYS_UNIT "degC"
    /end CHARACTERISTIC

    /begin CHARACTERISTIC CAL_dtsMax "upper limit DTS temperature"
      VALUE 0x70030108 RL_FLOAT32 300 NO_COMPU_METHOD -50 170
