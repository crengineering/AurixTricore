    /* Navigation state: Xcp_Fusion @ 0x70030500 (see Measurements.h) */
    /begin MEASUREMENT FusTickMs "uptime when the navigation block was last written"
      ULONG NO_COMPU_METHOD 0 0 0 4294967295
      ECU_ADDRESS 0x70030504
      PHYS_UNIT "ms"
    /end MEASUREMENT

    /begin MEASUREMENT Roll "roll angle, positive right side down"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -180 180
      ECU_ADDRESS 0x70030508
      PHYS_UNIT "deg"
    /end MEASUREMENT

    /begin MEASUREMENT Pitch "pitch angle, positive nose up; clamped at +/-90"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -90 90
      ECU_ADDRESS 0x7003050C
      PHYS_UNIT "deg"
    /end MEASUREMENT

    /begin MEASUREMENT Yaw "heading, true north when the NVM declination is set"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 360
      ECU_ADDRESS 0x70030510
      PHYS_UNIT "deg"
    /end MEASUREMENT

    /begin MEASUREMENT Quat0 "body-to-NED quaternion component 0 (w,x,y,z order)"
