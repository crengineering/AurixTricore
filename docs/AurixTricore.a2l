    /end CHARACTERISTIC

    /begin CHARACTERISTIC GPIO_P00_06_state "P00.6 output level (0=OFF/low, 1=ON/high)"
      VALUE 0x7003030A RL_UBYTE 1 NO_COMPU_METHOD 0 1
    /end CHARACTERISTIC

    /begin CHARACTERISTIC GPIO_P00_07_state "P00.7 output level (0=OFF/low, 1=ON/high)"
