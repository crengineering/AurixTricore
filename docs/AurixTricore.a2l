      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -100 100
      ECU_ADDRESS 0x7003053C
      PHYS_UNIT "m/s^2"
    /end MEASUREMENT

    /begin MEASUREMENT AccNed1 "acceleration along NED axis 1 with gravity removed"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -100 100
      ECU_ADDRESS 0x70030540
      PHYS_UNIT "m/s^2"
    /end MEASUREMENT

    /begin MEASUREMENT AccNed2 "acceleration along NED axis 2 with gravity removed"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -100 100
      ECU_ADDRESS 0x70030544
      PHYS_UNIT "m/s^2"
    /end MEASUREMENT

    /begin MEASUREMENT AccMagnitude "|a|, the orientation-independent health check; 1.0 at rest"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 16
      ECU_ADDRESS 0x70030548
      PHYS_UNIT "g"
    /end MEASUREMENT

    /begin MEASUREMENT MagFieldCorrected "|B| after hard-iron correction; must not change as the board rotates"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 4
      ECU_ADDRESS 0x7003054C
      PHYS_UNIT "gauss"
    /end MEASUREMENT

    /begin MEASUREMENT AhrsState "0=calibrating gyro bias, 1=aligning, 2=running, 3=no sensor"
      UBYTE NO_COMPU_METHOD 0 0 0 3
      ECU_ADDRESS 0x70030550
    /end MEASUREMENT

    /begin MEASUREMENT AhrsAccTrusted "1 while |a| is close enough to 1 g for gravity to dominate"
      UBYTE NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030551
    /end MEASUREMENT

    /begin MEASUREMENT AhrsMagTrusted "1 while |B| is plausible and is correcting yaw"
      UBYTE NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x70030552
    /end MEASUREMENT

    /begin MEASUREMENT PosDown "position along NED down, relative to the origin; POSITIVE IS DOWN"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -10000 10000
      ECU_ADDRESS 0x70030554
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT VelDown "velocity along NED down; positive is descending"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -100 100
      ECU_ADDRESS 0x70030558
      PHYS_UNIT "m/s"
    /end MEASUREMENT

    /begin MEASUREMENT AccBiasDown "estimated accelerometer bias on the down axis; ~0.01..0.02 on this board"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -5 5
      ECU_ADDRESS 0x7003055C
      PHYS_UNIT "m/s^2"
    /end MEASUREMENT

    /begin MEASUREMENT BaroBias "barometer offset against GNSS altitude - the weather drift, not the sensor"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -100 100
      ECU_ADDRESS 0x70030560
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT InnovDown "barometer innovation: what the baro said minus what the filter expected"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -100 100
      ECU_ADDRESS 0x70030564
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT VarDown "variance of PosDown; sqrt of this is the altitude uncertainty"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 1000000
      ECU_ADDRESS 0x70030568
      PHYS_UNIT "m^2"
    /end MEASUREMENT

    /begin MEASUREMENT PosNorth "metres north of the tangent-plane origin (first usable GNSS fix)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -100000 100000
      ECU_ADDRESS 0x7003056C
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT PosEast "metres east of the tangent-plane origin"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -100000 100000
      ECU_ADDRESS 0x70030570
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT VelNorth "velocity north"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -200 200
      ECU_ADDRESS 0x70030574
      PHYS_UNIT "m/s"
    /end MEASUREMENT

    /begin MEASUREMENT VelEast "velocity east"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -200 200
      ECU_ADDRESS 0x70030578
      PHYS_UNIT "m/s"
    /end MEASUREMENT

    /begin MEASUREMENT AccBiasNorth "estimated accelerometer bias north; mostly absorbs attitude error"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -5 5
      ECU_ADDRESS 0x7003057C
      PHYS_UNIT "m/s^2"
    /end MEASUREMENT

    /begin MEASUREMENT AccBiasEast "estimated accelerometer bias east"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -5 5
      ECU_ADDRESS 0x70030580
      PHYS_UNIT "m/s^2"
    /end MEASUREMENT

    /begin MEASUREMENT InnovNorth "GNSS north innovation"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -1000 1000
      ECU_ADDRESS 0x70030584
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT InnovEast "GNSS east innovation"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -1000 1000
      ECU_ADDRESS 0x70030588
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT VarNorth "variance of PosNorth; grows without bound until a GNSS fix arrives"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 1000000
      ECU_ADDRESS 0x7003058C
      PHYS_UNIT "m^2"
    /end MEASUREMENT

    /begin MEASUREMENT OriginLat "latitude of the tangent-plane origin"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -90 90
      ECU_ADDRESS 0x70030590
      PHYS_UNIT "deg"
    /end MEASUREMENT

    /begin MEASUREMENT OriginLon "longitude of the tangent-plane origin"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -180 180
      ECU_ADDRESS 0x70030594
      PHYS_UNIT "deg"
    /end MEASUREMENT

    /begin MEASUREMENT OriginAlt "GNSS altitude at the origin fix, above mean sea level"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -1000 10000
      ECU_ADDRESS 0x70030598
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT BaroRejects "barometer samples rejected by the outlier gate; a rising count is a sensor fault, not a tuning knob"
      ULONG NO_COMPU_METHOD 0 0 0 4294967295
      ECU_ADDRESS 0x7003059C
    /end MEASUREMENT

    /begin MEASUREMENT BaroResets "vertical re-acquisitions after a run of rejections; non-zero means the filter diverged and recovered"
      ULONG NO_COMPU_METHOD 0 0 0 4294967295
      ECU_ADDRESS 0x700305A0
    /end MEASUREMENT

    /begin MEASUREMENT GnssRejects "GNSS fixes rejected by the outlier gate"
      ULONG NO_COMPU_METHOD 0 0 0 4294967295
      ECU_ADDRESS 0x700305A4
    /end MEASUREMENT

    /begin MEASUREMENT GnssUpdates "GNSS fixes actually fused; increments once per new iTOW, i.e. 1 Hz with a fix"
      ULONG NO_COMPU_METHOD 0 0 0 4294967295
      ECU_ADDRESS 0x700305A8
    /end MEASUREMENT

    /begin MEASUREMENT VerticalOk "1 once the barometer has anchored the vertical channel"
      UBYTE NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x700305AC
    /end MEASUREMENT

    /begin MEASUREMENT HorizontalOk "1 once GNSS has anchored the horizontal channels"
      UBYTE NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x700305AD
    /end MEASUREMENT

    /begin MEASUREMENT OriginSet "1 once a usable fix defined the tangent-plane origin"
      UBYTE NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x700305AE
    /end MEASUREMENT

    /begin MEASUREMENT CovResets "numerical health-check trips. MUST stay 0 - any other value is a bug, not a tuning problem"
      ULONG NO_COMPU_METHOD 0 0 0 4294967295
      ECU_ADDRESS 0x700305B0
    /end MEASUREMENT

    /begin MEASUREMENT GnssITow "GPS time of week of the last fix actually fused; frozen with gnssUpdates stalled means iTOW is not being decoded"
      ULONG NO_COMPU_METHOD 0 0 0 4294967295
      ECU_ADDRESS 0x700305B4
      PHYS_UNIT "ms"
    /end MEASUREMENT

    /begin MEASUREMENT GnssDupes "polls that carried an already-fused fix; small but non-zero is healthy, exactly zero or near the poll rate is a fault"
      ULONG NO_COMPU_METHOD 0 0 0 4294967295
      ECU_ADDRESS 0x700305B8
    /end MEASUREMENT

    /begin MEASUREMENT AhrsBiasDegraded "1 = the boot gyro-bias calibration hit its 10 s deadline instead of completing a still window, i.e. the board was moving at power-on. The estimate still runs, it is just less good"
      UBYTE NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x700305BC
    /end MEASUREMENT

    /begin MEASUREMENT CtrlPhiIst0 "FLIGHT CONTROL FEEDBACK: attitude for att_ctrl_step, element 0 of [roll, pitch, yaw]. RADIANS, not degrees - this is the controller's own unit"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -6.3 6.3
      ECU_ADDRESS 0x700305C0
      PHYS_UNIT "rad"
    /end MEASUREMENT

    /begin MEASUREMENT CtrlPhiIst1 "FLIGHT CONTROL FEEDBACK: attitude for att_ctrl_step, element 1 of [roll, pitch, yaw]. RADIANS, not degrees - this is the controller's own unit"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -6.3 6.3
      ECU_ADDRESS 0x700305C4
      PHYS_UNIT "rad"
    /end MEASUREMENT

    /begin MEASUREMENT CtrlPhiIst2 "FLIGHT CONTROL FEEDBACK: attitude for att_ctrl_step, element 2 of [roll, pitch, yaw]. RADIANS, not degrees - this is the controller's own unit"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -6.3 6.3
      ECU_ADDRESS 0x700305C8
      PHYS_UNIT "rad"
    /end MEASUREMENT

    /begin MEASUREMENT CtrlOmIst0 "FLIGHT CONTROL FEEDBACK: body rate for rate_ctrl_step, element 0 of [p, q, r]. RAD/S"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -35 35
      ECU_ADDRESS 0x700305CC
      PHYS_UNIT "rad/s"
    /end MEASUREMENT

    /begin MEASUREMENT CtrlOmIst1 "FLIGHT CONTROL FEEDBACK: body rate for rate_ctrl_step, element 1 of [p, q, r]. RAD/S"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -35 35
      ECU_ADDRESS 0x700305D0
      PHYS_UNIT "rad/s"
    /end MEASUREMENT

    /begin MEASUREMENT CtrlOmIst2 "FLIGHT CONTROL FEEDBACK: body rate for rate_ctrl_step, element 2 of [p, q, r]. RAD/S"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -35 35
      ECU_ADDRESS 0x700305D4
      PHYS_UNIT "rad/s"
    /end MEASUREMENT

    /begin MEASUREMENT CtrlPNedIst0 "FLIGHT CONTROL FEEDBACK: position for pos_ctrl_step, element 0 of [north, east, down]"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -100000 100000
      ECU_ADDRESS 0x700305D8
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT CtrlPNedIst1 "FLIGHT CONTROL FEEDBACK: position for pos_ctrl_step, element 1 of [north, east, down]"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -100000 100000
      ECU_ADDRESS 0x700305DC
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT CtrlPNedIst2 "FLIGHT CONTROL FEEDBACK: position for pos_ctrl_step, element 2 of [north, east, down]"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -100000 100000
      ECU_ADDRESS 0x700305E0
      PHYS_UNIT "m"
    /end MEASUREMENT

    /begin MEASUREMENT CtrlVBIst0 "FLIGHT CONTROL FEEDBACK: velocity for pos_ctrl_step, element 0 of [u, v, w]. BODY frame, rotated out of NED by the current attitude - feeding it NED velocity would make the damping term wrong by the heading angle"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -200 200
      ECU_ADDRESS 0x700305E4
      PHYS_UNIT "m/s"
    /end MEASUREMENT

    /begin MEASUREMENT CtrlVBIst1 "FLIGHT CONTROL FEEDBACK: velocity for pos_ctrl_step, element 1 of [u, v, w]. BODY frame, rotated out of NED by the current attitude - feeding it NED velocity would make the damping term wrong by the heading angle"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -200 200
      ECU_ADDRESS 0x700305E8
      PHYS_UNIT "m/s"
    /end MEASUREMENT

    /begin MEASUREMENT CtrlVBIst2 "FLIGHT CONTROL FEEDBACK: velocity for pos_ctrl_step, element 2 of [u, v, w]. BODY frame, rotated out of NED by the current attitude - feeding it NED velocity would make the damping term wrong by the heading angle"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 -200 200
      ECU_ADDRESS 0x700305EC
      PHYS_UNIT "m/s"
    /end MEASUREMENT

    /* Estimator tuning: Xcp_FusionCal @ 0x70030600, RAM only (FusionCal.h) */
    /begin CHARACTERISTIC FusKpAccel "TUNING - attitude: how hard the accelerometer pulls the gyro integral back toward gravity. Higher = tracks gravity faster but inherits vibration; lower = smoother but gyro drift shows. Fixes ROLL and PITCH only"
      VALUE 0x70030604 RL_FLOAT32 20 NO_COMPU_METHOD 0 20
      PHYS_UNIT "1/s"
    /end CHARACTERISTIC

    /begin CHARACTERISTIC FusKpMag "TUNING - attitude: same, for the magnetometer, which fixes YAW only. Deliberately half the accelerometer gain: indoors the magnetic field is the less trustworthy of the two"
      VALUE 0x70030608 RL_FLOAT32 20 NO_COMPU_METHOD 0 20
      PHYS_UNIT "1/s"
    /end CHARACTERISTIC

    /begin CHARACTERISTIC FusKiGyroBias "TUNING - attitude: integral gain that tracks slow gyro-bias drift. Small, because the boot calibration already removed the bulk of it"
      VALUE 0x7003060C RL_FLOAT32 1 NO_COMPU_METHOD 0 1
      PHYS_UNIT "1/s^2"
    /end CHARACTERISTIC

    /begin CHARACTERISTIC FusSigmaAccDown "TUNING - vertical: how much the filter distrusts the accelerometer when predicting altitude. THE knob to raise once motors are running, because vibration is not in the 0.3 measured on a desk"
      VALUE 0x70030610 RL_FLOAT32 20 NO_COMPU_METHOD 0.001 20
      PHYS_UNIT "m/s^2"
    /end CHARACTERISTIC

    /begin CHARACTERISTIC FusSigmaBaro "TUNING - vertical: barometer noise. MEASURED (0.0197 m); R is this value SQUARED. Changing the BMP581 IIR setting invalidates it - re-measure, do not guess"
      VALUE 0x70030614 RL_FLOAT32 10 NO_COMPU_METHOD 0.001 10
      PHYS_UNIT "m"
    /end CHARACTERISTIC

    /begin CHARACTERISTIC FusSigmaBaroDrift "TUNING - vertical: how fast the barometer's zero wanders with weather. Measured 0.19 m/min on a still desk. This is the WEATHER, not the sensor"
      VALUE 0x70030618 RL_FLOAT32 1 NO_COMPU_METHOD 0 1
      PHYS_UNIT "m/sqrt(s)"
    /end CHARACTERISTIC

    /begin CHARACTERISTIC FusTauBaroDrift "TUNING - vertical: time constant over which that barometer drift reverts toward zero. Without mean reversion the altitude variance grows without bound, because a barometer alone can only ever observe (altitude + drift), never either one"
      VALUE 0x7003061C RL_FLOAT32 10000 NO_COMPU_METHOD 1 10000
      PHYS_UNIT "s"
    /end CHARACTERISTIC

    /begin CHARACTERISTIC FusSigmaAccHoriz "TUNING - horizontal: accelerometer distrust for north/east. Larger than the vertical one because horizontal acceleration is contaminated by ATTITUDE error - one degree of tilt error tips 0.17 m/s^2 of gravity into the horizontal plane"
      VALUE 0x70030620 RL_FLOAT32 20 NO_COMPU_METHOD 0.001 20
      PHYS_UNIT "m/s^2"
    /end CHARACTERISTIC

    /begin CHARACTERISTIC FusSigmaGnssVel "TUNING - horizontal: GNSS velocity noise. Currently pessimistic at 0.3 against a receiver good to about 0.05 - this is Doppler-derived and is the best measurement available for a position loop"
      VALUE 0x70030624 RL_FLOAT32 20 NO_COMPU_METHOD 0.001 20
      PHYS_UNIT "m/s"
    /end CHARACTERISTIC

    /begin CHARACTERISTIC FusGnssPosRScale "TUNING - horizontal: multiplies the GNSS position R. 1.0 trusts hAcc as a single independent fix, which is WRONG at 10 Hz because consecutive solutions share most of their information. Set to 8.0 after the outdoor run showed varN claiming 0.3 m against a real 2.59 m"
      VALUE 0x70030628 RL_FLOAT32 1000 NO_COMPU_METHOD 0.1 1000
    /end CHARACTERISTIC

    /begin CHARACTERISTIC FusGateSigmaSq "TUNING - outlier gate, in sigma SQUARED (25 = 5 sigma). Rejects a measurement this far from what the filter expected"
      VALUE 0x7003062C RL_FLOAT32 10000 NO_COMPU_METHOD 1 10000
    /end CHARACTERISTIC

    /begin CHARACTERISTIC FusGateMinMetres "TUNING - absolute floor on the barometer gate. Without it the gate converges to +/-0.1 m and starts rejecting real motion: a 30 cm hand lift already reached 62 percent of it. The gate is for CORRUPT readings, not for manoeuvres"
      VALUE 0x70030630 RL_FLOAT32 1000 NO_COMPU_METHOD 0.01 1000
      PHYS_UNIT "m"
    /end CHARACTERISTIC

  /end MODULE
/end PROJECT
