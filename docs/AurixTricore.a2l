    /begin CHARACTERISTIC NVM_command "NVM command: 0x45564153 SAVE, 0x544C4644 load defaults; firmware clears to 0"
      VALUE 0x70030204 RL_ULONG 4294967295 NO_COMPU_METHOD 0 4294967295
    /end CHARACTERISTIC

    /begin CHARACTERISTIC NVM_userValue "persistent user scratch word (survives reset after SAVE)"
      VALUE 0x70030208 RL_ULONG 4294967295 NO_COMPU_METHOD 0 4294967295
    /end CHARACTERISTIC

    /* ------------------------------------------------------------------ */
    /* GPIO control: Xcp_Gpio @ 0x70030300, 52 bytes (see gpio.h)         */
    /*   0x04 state[16]  0=OFF, 1=ON                       (writable)     */
    /*   0x14 mode[16]   0=digital, 1=PWM, 2=reserved      (READ-ONLY)    */
    /*   0x24 duty[16]   PWM duty cycle 0..100 %           (writable)     */
    /* Which pins are user-controllable and which are PWM is fixed in     */
    /* firmware (gpio_cfg.h); reserved pins (e.g. P00.0, diagnostics) are */
    /* not exposed here and cannot be driven over XCP. For a PWM pin,     */
    /* state acts as an enable: OFF forces 0 % duty (output low), ON      */
    /* applies the duty value. Duty writes to digital pins are accepted   */
    /* but have no effect.                                                */
    /* ------------------------------------------------------------------ */

    /begin CHARACTERISTIC GPIO_P00_01_state "P00.1 output level (0=OFF/low, 1=ON/high)"
      VALUE 0x70030305 RL_UBYTE 1 NO_COMPU_METHOD 0 1
    /end CHARACTERISTIC

    /begin CHARACTERISTIC GPIO_P00_02_state "P00.2 output level (0=OFF/low, 1=ON/high)"
      VALUE 0x70030306 RL_UBYTE 1 NO_COMPU_METHOD 0 1
    /end CHARACTERISTIC

    /begin CHARACTERISTIC GPIO_P00_03_state "P00.3 output level (0=OFF/low, 1=ON/high)"
