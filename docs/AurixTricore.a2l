      ECU_ADDRESS 0x70030018
      PHYS_UNIT "V"
    /end MEASUREMENT

    /begin MEASUREMENT VEXT "5 V board supply (PMS monitor ADC)"
      FLOAT32_IEEE NO_COMPU_METHOD 0 0 0 6
      ECU_ADDRESS 0x7003001C
      PHYS_UNIT "V"
    /end MEASUREMENT

    /begin MEASUREMENT RawVdd "raw monitor ADC code VDD"
