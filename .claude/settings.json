{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" 2>/dev/null; python tools/check_docs.py --quiet || exit 2",
            "timeout": 60,
            "statusMessage": "Checking documentation against the code..."
          }
        ]
      }
    ]
  }
}
